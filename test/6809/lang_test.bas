10 REM 6809 EXT BASIC LANGUAGE TEST
20 A=(2+3)*4
30 IF A<>20 THEN PRINT "FAIL A" : END
40 B=2+3*4
50 IF B<>14 THEN PRINT "FAIL B" : END
60 FOR I=1 TO 5
70 S=S+I
80 NEXT I
90 IF S<>15 THEN PRINT "FAIL FOR" : END
100 GOSUB 900
110 IF Z<>42 THEN PRINT "FAIL GOSUB" : END
120 DIM Q(3)
130 Q(1)=7:Q(2)=9:Q(3)=Q(1)+Q(2)
140 IF Q(3)<>16 THEN PRINT "FAIL DIM" : END
150 DATA 3,1,4
160 READ D1,D2,D3
170 IF D1<>3 THEN PRINT "FAIL D1" : END
180 IF D2<>1 THEN PRINT "FAIL D2" : END
190 IF D3<>4 THEN PRINT "FAIL D3" : END
200 RESTORE
210 READ R1
220 IF R1<>3 THEN PRINT "FAIL RESTORE" : END
230 T$="HELLO"
240 IF LEFT$(T$,2)<>"HE" THEN PRINT "FAIL LEFT$" : END
250 IF RIGHT$(T$,2)<>"LO" THEN PRINT "FAIL RIGHT$" : END
260 IF MID$(T$,2,3)<>"ELL" THEN PRINT "FAIL MID$" : END
270 C$=CHR$(65)
280 IF C$<>"A" THEN PRINT "FAIL CHR$" : END
290 IF ASC(C$)<>65 THEN PRINT "FAIL ASC" : END
300 IF VAL("123")<>123 THEN PRINT "FAIL VAL" : END
310 IF INT(3.9)<>3 THEN PRINT "FAIL INT" : END
320 IF ABS(-8)<>8 THEN PRINT "FAIL ABS" : END
330 R=RND(1)
340 IF R<0 THEN PRINT "FAIL RND1" : END
350 IF R>1 THEN PRINT "FAIL RND2" : END
360 ON 2 GOTO 380,390,400
370 PRINT "FAIL ONGOTO" : END
380 PRINT "FAIL ONGOTO2" : END
390 X=99
400 IF X<>99 THEN PRINT "FAIL ONGOTO3" : END
405 I1=32767
406 I2=-32768
407 IF I1+1<>32768 THEN PRINT "FAIL IADD" : END
408 IF I2+1<>-32767 THEN PRINT "FAIL INEG" : END
409 IF (12345*7)-86415<>0 THEN PRINT "FAIL IMUL" : END
410 IF (100000/25)<>4000 THEN PRINT "FAIL IDIV" : END
420 F1=1/3
430 F2=F1*3
440 IF ABS(F2-1)>.0001 THEN PRINT "FAIL F13" : END
450 F3=.1+.2
460 IF ABS(F3-.3)>.0001 THEN PRINT "FAIL F12" : END
470 F4=SQR(2)^2
480 IF ABS(F4-2)>.001 THEN PRINT "FAIL FSQR" : END
490 IF INT(-3.1)<>-4 THEN PRINT "FAIL IINTN" : END
495 T1=SIN(0)
500 IF ABS(T1)>.0001 THEN PRINT "FAIL SIN0" : END
505 T2=COS(0)
510 IF ABS(T2-1)>.0001 THEN PRINT "FAIL COS0" : END
515 T3=TAN(0)
520 IF ABS(T3)>.0001 THEN PRINT "FAIL TAN0" : END
525 P=ATN(1)*4
530 IF ABS(SIN(P/2)-1)>.001 THEN PRINT "FAIL SINPI2" : END
535 IF ABS(COS(P)+1)>.001 THEN PRINT "FAIL COSPI" : END
540 E1=EXP(1)
545 IF ABS(E1-2.7182818)>.001 THEN PRINT "FAIL EXP1" : END
550 L1=LOG(E1)
555 IF ABS(L1-1)>.001 THEN PRINT "FAIL LOGE" : END
560 GOTO 920
900 Z=40+2
910 RETURN
920 PRINT "BASIC LANGUAGE TEST PASS"
930 END
