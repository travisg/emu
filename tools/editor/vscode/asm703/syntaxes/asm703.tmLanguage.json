{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Raytheon 703 assembly",
  "scopeName": "source.asm703",
  "comment": "Generated by tools/editor/gen_syntax.py from asm703.py -- edit that, not this.",
  "patterns": [
    {
      "match": "^'.*$",
      "name": "comment.line.card.asm703"
    },
    {
      "match": "^(?:(\\.[^\\s;]*)|([^\\s;\\'.][^\\s;]*))(?:[ \\t]+(?:((?i:EXIT|HLT|INR|JMP|JSX))|((?i:DXS|IXS|SAM|SAO|SAP|SAZ|SEQ|SGR|SLE|SLS|SNE|SNO|SS0|SS1|SS2|SS3|SSE|SXE|SXM|SXP))|((?i:SMB|SML|SMU))|((?i:SUBR))|((?i:BYTE|DATA|TEXT|WORD|RES|STR|D))|((?i:LPOOL|MACRO|ENDC|ENDM|FALS|LIBR|NTRY|ORIG|TRUE|END|EQU|ORG|SEG))|((?i:EXCH|ADD|AND|CAX|CEX|CLB|CLR|CMB|CMP|CMW|CXA|CXE|DIN|DIV|DOT|DSB|ENB|INV|LDB|LDW|LDX|LLB|MPY|MSK|NOP|ORE|ORI|SGM|SLM|STB|STW|STX|SUB|UNM))|((?i:(?:SLA|SLC|SLL|SRA|SRC|SRL)[ \\t]+[DLR](?=[ \\t;]|$)|SLAD|SLCD|SLCL|SLCR|SLLD|SLLL|SLLR|SRAD|SRCD|SRCL|SRCR|SRLD|SRLL|SRLR|SLA|SLC|SLL|SRA|SRC|SRL))|((?i:[A-Za-z_][\\w.]*)))(?=[ \\t;]|$)(?:[ \\t]+([=*/]+))?)?",
      "captures": {
        "3": {
          "name": "keyword.control.flow.asm703"
        },
        "4": {
          "name": "keyword.control.skip.asm703"
        },
        "5": {
          "name": "support.type.page.asm703"
        },
        "6": {
          "name": "storage.type.function.asm703"
        },
        "7": {
          "name": "storage.type.data.asm703"
        },
        "8": {
          "name": "keyword.other.directive.asm703"
        },
        "9": {
          "name": "keyword.other.instruction.asm703"
        },
        "10": {
          "name": "keyword.other.instruction.shift.asm703"
        },
        "11": {
          "name": "entity.name.function.macro.asm703"
        },
        "12": {
          "name": "keyword.operator.prefix.asm703"
        },
        "1": {
          "name": "entity.name.label.local.asm703"
        },
        "2": {
          "name": "entity.name.function.label.asm703"
        }
      }
    },
    {
      "match": "^[ \\t]+(?:((?i:EXIT|HLT|INR|JMP|JSX))|((?i:DXS|IXS|SAM|SAO|SAP|SAZ|SEQ|SGR|SLE|SLS|SNE|SNO|SS0|SS1|SS2|SS3|SSE|SXE|SXM|SXP))|((?i:SMB|SML|SMU))|((?i:SUBR))|((?i:BYTE|DATA|TEXT|WORD|RES|STR|D))|((?i:LPOOL|MACRO|ENDC|ENDM|FALS|LIBR|NTRY|ORIG|TRUE|END|EQU|ORG|SEG))|((?i:EXCH|ADD|AND|CAX|CEX|CLB|CLR|CMB|CMP|CMW|CXA|CXE|DIN|DIV|DOT|DSB|ENB|INV|LDB|LDW|LDX|LLB|MPY|MSK|NOP|ORE|ORI|SGM|SLM|STB|STW|STX|SUB|UNM))|((?i:(?:SLA|SLC|SLL|SRA|SRC|SRL)[ \\t]+[DLR](?=[ \\t;]|$)|SLAD|SLCD|SLCL|SLCR|SLLD|SLLL|SLLR|SRAD|SRCD|SRCL|SRCR|SRLD|SRLL|SRLR|SLA|SLC|SLL|SRA|SRC|SRL))|((?i:[A-Za-z_][\\w.]*)))(?=[ \\t;]|$)(?:[ \\t]+([=*/]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.flow.asm703"
        },
        "2": {
          "name": "keyword.control.skip.asm703"
        },
        "3": {
          "name": "support.type.page.asm703"
        },
        "4": {
          "name": "storage.type.function.asm703"
        },
        "5": {
          "name": "storage.type.data.asm703"
        },
        "6": {
          "name": "keyword.other.directive.asm703"
        },
        "7": {
          "name": "keyword.other.instruction.asm703"
        },
        "8": {
          "name": "keyword.other.instruction.shift.asm703"
        },
        "9": {
          "name": "entity.name.function.macro.asm703"
        },
        "10": {
          "name": "keyword.operator.prefix.asm703"
        }
      }
    },
    {
      "include": "#operand"
    }
  ],
  "repository": {
    "operand": {
      "patterns": [
        {
          "begin": ";",
          "end": "$",
          "name": "comment.line.semicolon.asm703",
          "patterns": [
            {
              "match": "\\b(?:TODO|FIXME|XXX)\\b",
              "name": "keyword.todo.asm703"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.asm703",
          "patterns": [
            {
              "match": "\\\\[rnt0\\\\\"]",
              "name": "constant.character.escape.asm703"
            },
            {
              "match": "\\\\.",
              "name": "invalid.illegal.escape.asm703"
            }
          ]
        },
        {
          "match": "\\bX'[0-9A-Fa-f]+'",
          "name": "constant.numeric.hex.asm703"
        },
        {
          "match": "\\b0[xX][0-9A-Fa-f]+\\b",
          "name": "constant.numeric.hex.asm703"
        },
        {
          "match": "'[^']{1,2}'",
          "name": "string.quoted.single.asm703"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.decimal.asm703"
        },
        {
          "match": "\\$",
          "name": "variable.language.location.asm703"
        },
        {
          "match": "\\bLEN(?=\\()",
          "name": "support.function.builtin.asm703"
        },
        {
          "match": "(?<![\\w.])\\.[A-Za-z_]\\w*",
          "name": "variable.other.label.local.asm703"
        },
        {
          "match": "[A-Za-z_][\\w.]*",
          "name": "variable.other.asm703"
        },
        {
          "match": "<=|>=|<>|[-+*/=<>]",
          "name": "keyword.operator.asm703"
        },
        {
          "match": ",",
          "name": "punctuation.separator.asm703"
        }
      ]
    }
  }
}
